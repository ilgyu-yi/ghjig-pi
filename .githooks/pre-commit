#!/usr/bin/env bash
# .githooks/pre-commit — local-tier adapter. Blocks a direct commit
# to a protected branch and a staged secret by SOURCING and CALLING the shared
# helpers — it copies NO check logic (single-source invariant).
# Arm ordering is load-bearing: each arm's helper is sourced immediately
# before that arm runs, so a helper failure (source or require miss)
# degrades that arm and every arm after it — an arm that has already run
# and decided is never undone.
# shellcheck source=/dev/null
. "$(dirname "${BASH_SOURCE[0]}")/_lib.sh"

# 1) Direct commit to the one derived protected identity P (SPEC 3.3's
#    ref-identity semantics; master/release/* stay enumerated-unmodeled).
githook_source branch_guard.sh branch || exit 0
githook_require current_branch branch
githook_require is_protected_branch branch
_gh_branch="$(current_branch)"
if is_protected_branch "$_gh_branch"; then
  githook_block branch "pre-commit: direct commit to the protected branch is blocked. Commit on a feature branch and open a PR."
  exit 1
fi

# 2) Staged secret (scan_staged_secrets reads git diff --cached).
githook_source secret_scan.sh  secret || exit 0
githook_require scan_staged_secrets secret
if ! scan_staged_secrets; then
  githook_block secret "pre-commit: the staged-secret scan refused this commit. Remove the flagged content, or allow-list the path in .shellsecretignore."
  exit 1
fi

exit 0
